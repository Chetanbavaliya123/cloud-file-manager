# ==============================================================================
# Cloud File Manager - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# IMPORTANT: Never commit the actual '.env' file containing secrets to Git!

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (REQUIRED for server-side private bucket access)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role (secret)
# CAUTION: Never expose this key in client-side code!
SUPABASE_KEY=your-supabase-service-role-secret-key-here

# Supabase Storage Bucket Name (must match the private bucket created in Supabase)
BUCKET_NAME=uploads

# Local Flask Server Port (Default is 5000)
PORT=5000

# Flask Secret Key for flash messages and session security
SECRET_KEY=cloud-file-manager-super-secret-key-replace-in-production
